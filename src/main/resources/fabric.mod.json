{
  "schemaVersion": 1,
  "id": "handycam",
  "version": "${version}",
  "name": "Handycam",
  "description": "Cinematic camera shake for Minecraft",
  "authors": [
    "vercim"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/handycam",
    "sources": "https://github.com/vercim/handycam",
    "issues": "https://github.com/vercim/handycam/issues"
  },

  
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/JfttnVcczU"
      },
      "badges": [ "deprecated" ],
      "update_checker": true
    }
  },


  "license": "LGPL-3.0-only",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.vercim.handycam.fabric.client.HandycamFabricClient"
    ],
    "modmenu": [
      "dev.vercim.handycam.fabric.client.HandycamModMenuIntegration"
    ]
  },
  "mixins": [
    "handycam.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_api_version}",
    "cloth-config": ">=${cloth_config_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
